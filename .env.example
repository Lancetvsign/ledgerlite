# LedgerLite environment variables.
# NAMES AND EXPLANATIONS ONLY — never commit a real value to this file.
# Copy to .env.local and fill in from your own Neon dev branch.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# POOLED connection string for YOUR OWN development branch (e.g. dev/lance).
# Hostname contains "-pooler". Used by the application at runtime — both the HTTP
# client (reads) and the Pool client (financial writes). Never a production branch.
# See docs/DECISIONS.md ADR-001 for why there are two clients.
DATABASE_URL=

# DIRECT (unpooled) connection string for the SAME branch — same host WITHOUT
# "-pooler". Used only by migrations and other session-level work.
#
# Neon's pooled endpoint is PgBouncer in transaction pooling mode, where a client
# session is not pinned to one backend. pg_advisory_lock() is session-level, so on
# the pooled endpoint the migration lock would silently protect nothing.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Authentication (Better Auth) — arrives in LL-010, placeholder for now
# ---------------------------------------------------------------------------

# Random 32+ byte secret. Generate per environment; never share across environments.
BETTER_AUTH_SECRET=

# Canonical base URL for this environment, e.g. http://localhost:3000
BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# One of: development | test | preview | production
# Destructive database work (integration tests, db:verify, db:mark-test) refuses
# to run unless this is exactly "test". Layer 1 of the guard in src/db/safety.ts.
APP_ENV=development

# Comma-separated host substrings explicitly approved for destructive use, e.g.
# the endpoint id of your own Neon dev branch: ep-quiet-meadow-42
# An empty or unset allowlist approves NOTHING. Layer 2 of the guard.
TEST_DATABASE_ALLOWLIST=

# One of: debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Bank-statement import (LL-076, ADR-034) — AI extraction through Vercel AI Gateway
# ---------------------------------------------------------------------------

# Local development only. On Vercel deployments the gateway authenticates with the
# deployment's OIDC token automatically and this is NOT needed. Without either, the
# upload page reports "extraction not configured"; review/posting of staged lines still works.
# Create at: Vercel dashboard → AI Gateway → API keys.
AI_GATEWAY_API_KEY=

# Optional. A gateway `provider/model` id for statement extraction; defaults to the value
# of DEFAULT_BANK_IMPORT_MODEL in src/server/bank-import/extract.ts.
BANK_IMPORT_MODEL=

# Test/e2e only — replaces extraction with a fixed synthetic statement. Never set in
# production or preview (playwright.config.ts sets it for the e2e server).
BANK_IMPORT_TEST_EXTRACTOR=

# ---------------------------------------------------------------------------
# CI only — set as GitHub Actions secrets, never in a local file
# ---------------------------------------------------------------------------

# NEON_API_KEY       Creates and destroys ephemeral test branches in CI
# NEON_PROJECT_ID    Identifies the Neon project those branches belong to
