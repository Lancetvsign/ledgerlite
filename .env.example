# LedgerLite environment variables.
# NAMES AND EXPLANATIONS ONLY — never commit a real value to this file.
# Copy to .env.local and fill in from your own Neon dev branch.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string for YOUR OWN development branch
# (e.g. dev/lance, dev/claude). Never a production branch.
# Used by both the HTTP client (reads) and the Pool client (financial writes).
# See docs/DECISIONS.md ADR-001 for why there are two clients.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication (Better Auth) — arrives in LL-010, placeholder for now
# ---------------------------------------------------------------------------

# Random 32+ byte secret. Generate per environment; never share across environments.
BETTER_AUTH_SECRET=

# Canonical base URL for this environment, e.g. http://localhost:3000
BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# One of: development | test | preview | production
# Database-backed tests refuse to run unless this is "test". See LL-003.
APP_ENV=development

# One of: debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# CI only — set as GitHub Actions secrets, never in a local file
# ---------------------------------------------------------------------------

# NEON_API_KEY       Creates and destroys ephemeral test branches in CI
# NEON_PROJECT_ID    Identifies the Neon project those branches belong to
